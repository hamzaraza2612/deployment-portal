# Postgres
POSTGRES_USER=deployment_portal
POSTGRES_PASSWORD=change_me
POSTGRES_DB=deployment_portal
DATABASE_URL=postgresql://deployment_portal:change_me@postgres:5432/deployment_portal

# Backend
PORT=4000
JWT_SECRET=change_me_to_a_long_random_string
# 32-byte key, base64 or hex, used for AES-256-GCM encryption of stored SSH/Git credentials
ENCRYPTION_KEY=change_me_to_a_32_byte_key_base64
COOKIE_SECURE=false

# Seeded on first backend startup if no users exist
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# Frontend
VITE_API_URL=/api
