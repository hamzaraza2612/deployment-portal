# Copy this file to .env and fill in real values before running `docker compose up -d`.
# Never commit the real .env file.

# --- PostgreSQL ---
POSTGRES_USER=portal
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=deployment_portal

# --- Backend / API ---
# Random 32-byte hex string used to sign session JWTs. Generate with:
#   openssl rand -hex 32
JWT_SECRET=change-me-jwt-secret
JWT_EXPIRES_IN=8h

# Random 32-byte (64 hex char) key used to encrypt stored credentials (SSH keys, passwords, git tokens).
# Generate with:
#   openssl rand -hex 32
ENCRYPTION_KEY=change-me-64-character-hex-encryption-key

# Origin allowed to call the API with credentials (browser CORS). Match the URL you access the portal at.
CORS_ORIGIN=http://localhost:8080

# Set to true once the portal is served over HTTPS so auth cookies require TLS.
COOKIE_SECURE=false

# --- Initial admin account (created by the seed script on first boot) ---
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-strong-password

# --- Frontend ---
# Host port the portal UI is exposed on.
PORTAL_HTTP_PORT=8080
