generator client {
  provider      = "prisma-client-js"
  // Pin the musl/OpenSSL 3 engine explicitly instead of relying on Prisma's
  // runtime auto-detection, which can still misfire on Alpine even with
  // OpenSSL installed.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum AuthType {
  PASSWORD
  PRIVATE_KEY
}

enum DeploymentStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum PromotionStatus {
  PENDING
  DEPLOYED
  CANCELLED
}

model User {
  id                 String       @id @default(cuid())
  email              String       @unique
  passwordHash       String
  name               String
  role               Role         @default(VIEWER)
  // Environment tags (matching Server.environment) this user can see, ignored for ADMIN
  // (who always sees everything). Empty means no environment access yet.
  allowedEnvironments String[]    @default([])
  createdAt          DateTime     @default(now())
  deployments        Deployment[]
  promotionRequests  PromotionRequest[]
  auditLogs          AuditLog[]
}

model Server {
  id            String       @id @default(cuid())
  name          String
  // Free-text environment tag used to group servers in the portal, e.g. "Dev", "Staging", "Production".
  environment   String       @default("Production")
  host          String
  port          Int          @default(22)
  sshUser       String
  authType      AuthType     @default(PASSWORD)
  // AES-256-GCM encrypted password, or encrypted private key (+ optional passphrase, stored as JSON)
  secret        String
  gitBaseDir    String       @default("/mnt/data/git-directory")
  auditLogPath  String       @default("/mnt/data/deployment_audit.log")
  // Deployment base paths available on this server, e.g. ["/mnt/data/techbey-apps", "/mnt/data/techbey-apps8"]
  basePaths     String[]     @default([])
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  deployments   Deployment[]
  promotionRequests PromotionRequest[]
}

model Repository {
  id          String       @id @default(cuid())
  name        String
  url         String
  username    String
  // AES-256-GCM encrypted token/password
  secret      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deployments Deployment[]
}

// A saved git host credential (e.g. one entry for "gitlab.techbey.pk") so adding a new
// Repository on an already-known host doesn't require re-entering the username/token —
// its stored username/secret are copied onto the new Repository row at creation time.
// Repository keeps its own copy rather than a live reference so nothing here changes if
// this credential is later edited or removed; re-save affected repos to rotate them.
model GitCredential {
  id        String   @id @default(cuid())
  host      String   @unique
  username  String
  // AES-256-GCM encrypted token/password
  secret    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per sensitive action across the portal (create/update/delete, deploys, config
// file edits, container actions, ...) so an Admin can see who did what and when. userName/
// userEmail are a snapshot taken at write time (from the JWT, no extra lookup) so the log
// stays meaningful even after the acting user's account is later deleted (userId -> null).
model AuditLog {
  id        String   @id @default(cuid())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    String?
  userName  String
  userEmail String
  action    String
  summary   String
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

model Deployment {
  id             String           @id @default(cuid())
  server         Server           @relation(fields: [serverId], references: [id])
  serverId       String
  repository     Repository       @relation(fields: [repositoryId], references: [id])
  repositoryId   String
  branch         String
  sourcePath     String
  basePath       String
  appName        String
  appPath        String
  publishDir     String
  backupName     String?
  backupPath     String?
  status         DeploymentStatus @default(PENDING)
  log            String           @default("")
  errorMessage   String?
  triggeredBy    User             @relation(fields: [triggeredById], references: [id])
  triggeredById  String
  startedAt      DateTime         @default(now())
  finishedAt     DateTime?

  // True when this row is a revert-to-backup run rather than a normal deploy.
  isRevert       Boolean          @default(false)
  // The deployment whose backup this row restored, when isRevert is true.
  revertedFrom   Deployment?      @relation("DeploymentRevert", fields: [revertedFromId], references: [id])
  revertedFromId String?
  revertedBy     Deployment[]     @relation("DeploymentRevert")

  // Promotion requests that used this deployment as their source (e.g. "sent to QA").
  promotionRequestsAsSource PromotionRequest[] @relation("PromotionSource")
  // Set when this deployment row IS the executed result of a promotion.
  promotionRequestAsResult  PromotionRequest?  @relation("PromotionResult")

  @@index([serverId])
  @@index([status])
}

// A developer-initiated "please deploy this build to <environment>" request,
// e.g. "send this Dev deployment to QA". Created with the target environment
// only; the target server/app is resolved (auto-suggested, always editable)
// by whoever acts on it in the Promotions page, since app-folder naming can
// differ per environment (e.g. Production). Executing one creates a normal
// Deployment row via the same deploy pipeline as a manual deploy — it just
// re-checks-out the same branch and reuses the same relative source path on
// the target server, rather than hand-copying built files across servers.
model PromotionRequest {
  id                 String           @id @default(cuid())
  sourceDeployment   Deployment       @relation("PromotionSource", fields: [sourceDeploymentId], references: [id])
  sourceDeploymentId String
  targetEnvironment  String
  targetServer       Server?          @relation(fields: [targetServerId], references: [id])
  targetServerId     String?
  targetBasePath     String?
  targetAppName      String?
  status             PromotionStatus  @default(PENDING)
  requestedBy        User             @relation(fields: [requestedById], references: [id])
  requestedById      String
  resultDeployment   Deployment?      @relation("PromotionResult", fields: [resultDeploymentId], references: [id])
  resultDeploymentId String?          @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([targetEnvironment])
  @@index([status])
}

// A self-service URL/credential entry for an environment, e.g. "QA login for
// the Customer Portal" — so devs/QA don't have to remember every app's URL
// or ping someone for its password. Scoped by the same environment tag used
// on Server, and visible to any user with access to that environment.
model AppLink {
  id          String   @id @default(cuid())
  environment String
  name        String
  url         String
  username    String?
  // AES-256-GCM encrypted; unlike Server/Repository secrets this one IS
  // returned decrypted to any user with access to the environment, since the
  // whole point is self-service lookup.
  password    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([environment])
}
